{
  "name": "sign-language-dialogue-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "基于LLM智能体的手语对话系统 — 前端 SPA（前后端分离）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
